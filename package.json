{
  "name": "hack4hack-team-formation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:local": "node --import tsx scripts/init-local-env.ts",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts",
    "format": "prettier --write src tests scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:test:up": "docker compose -f compose.yaml -f compose.test.yaml --profile faults up -d --wait",
    "db:down": "docker compose -f compose.yaml -f compose.test.yaml --profile faults down"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.23",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "better-auth": "1.7.23",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.73.0",
    "mongodb": "7.9.0",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
